#
# DCO enforcement: rejects a commit locally unless it carries a
# "Signed-off-by:" trailer matching the committer's configured name/email
# (git commit -s). CI's DCO check catches this too, but only after a push
# and a PR review cycle; this hook catches it before the commit is even
# made, so a missing -s never reaches a PR in the first place.
#
# Installed via `make setup` (core.hooksPath=.githooks). Applies only to
# this repo — does not touch global git config.

set -euo pipefail

commit_msg_file="$1"

# Merge commits carry their own DCO trail via the merged commits; skip. Detected
# via MERGE_HEAD (an actual in-progress merge), not the commit message text —
# an ordinary commit whose subject happens to start with "Merge" is not a real
# merge, and a real merge with a custom subject wouldn't match a text check.
if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
  exit 0
fi

# Same reasoning for a rebase or cherry-pick replaying an existing commit: its message
# already carries the ORIGINAL AUTHOR's Signed-off-by trailer, which is what CI's DCO
# check (author-based) actually verifies. HOWEVER, in interactive rebase at an `edit` or
# `reword` stop, the tree or message may be rewritten by the current committer — in
# which case REBASE_HEAD stays set but the commit is genuinely new content needing a
# fresh Signed-off-by from the current committer.
replay_head=""
if git rev-parse -q --verify REBASE_HEAD >/dev/null 2>&1; then
  replay_head=REBASE_HEAD
elif git rev-parse -q --verify CHERRY_PICK_HEAD >/dev/null 2>&1; then
  replay_head=CHERRY_PICK_HEAD
fi

if [[ -n "$replay_head" ]]; then
  if ! author_ident=$(git var GIT_AUTHOR_IDENT); then
    echo "error: could not resolve author identity to verify DCO sign-off" >&2
    exit 1
  fi
  author_name_email=$(sed -E 's/ [0-9]+ [-+][0-9]{4}$//' <<<"$author_ident")
  if [[ -z "$author_name_email" ]]; then
    echo "error: could not resolve author identity to verify DCO sign-off" >&2
    exit 1
  fi
  expected_author_trailer="Signed-off-by: ${author_name_email}"

  # For a replay to skip committer sign-off, both the message AND the content
  # must be unchanged from the original commit. Message equality alone misses a
  # tree-only amend (e.g. `git commit --amend --no-edit` at an interactive-rebase
  # `edit` stop): the message and its Signed-off-by trailer survive untouched
  # while the tree changes underneath.
  #
  # `git patch-id --stable` deliberately ignores whitespace AND line numbers, so
  # it is NOT used directly: a whitespace-only amend would hash to the same id
  # as the original patch and be treated as a faithful replay, skipping the
  # current committer's sign-off for content that actually changed. Instead,
  # build a fingerprint from `git diff --binary` that keeps everything needed
  # to identify WHAT changed (file identity, mode/rename metadata, binary
  # content, and the actual +/- content lines, plus 1 line of surrounding
  # context) while normalizing away only what legitimately varies across a
  # replay landing on a different base commit: blob-oid `index` lines and
  # `@@ ... @@` hunk-header line numbers/counts. Earlier drafts of this filter
  # kept ONLY +/- content lines with no context at all, which let two edits of
  # identical content at DIFFERENT locations in the same file (e.g. a line
  # that reads "one" appearing twice, changed to "two" at one occurrence in
  # the original and at the other in a modified replay) fingerprint
  # identically and wrongly qualify for the exemption — the +/- lines alone
  # carry no positional signal once line numbers are stripped. Keeping 1 line
  # of context (`-U1`) restores enough surrounding-content signal to tell
  # those apart in the common case without reintroducing the full line-number
  # sensitivity `--stable` patch-id avoids; when even the 1-line context is
  # identical at both locations the edit is truly ambiguous from content
  # alone, and this hook fails closed (denies the exemption, falls through to
  # requiring the current committer's sign-off) rather than guessing. `--no-
  # ext-diff` pins this to git's built-in diff engine — otherwise a
  # `diff.external`/`GIT_EXTERNAL_DIFF` driver configured on the machine
  # replaces the diff BODY while `git diff --binary` still emits the ordinary
  # `diff --git` header, so the awk filter would keep the file-identity line
  # but silently lose the swapped-in body, letting a same-file content amend
  # during a rebase `edit` hash identically to the original.
  #
  # awk (not grep) does the filtering: grep exits 1 when nothing matches its
  # pattern, which happens whenever the diff is empty (e.g. `git diff
  # --cached` at a `reword`/`edit` rebase stop where nothing is staged) or has
  # no matching lines — under `set -euo pipefail`, an unguarded grep exit 1
  # here would abort the whole hook, including on an otherwise-correctly-
  # signed commit, before the committer-sign-off fallback ever runs. awk exits
  # 0 even when it prints nothing, so an empty diff yields a well-defined
  # empty-blob fingerprint instead of aborting. The trailing `|| true` guards
  # the rest of the pipeline too: under `set -o pipefail` (part of `-euo
  # pipefail`), a fatal `git diff` failure (not just "differences found" —
  # plain `git diff` without `--exit-code` only returns nonzero on an actual
  # error) would otherwise abort the whole hook via the `var=$(...)`
  # assignment at the call site before the committer-sign-off fallback ever
  # runs. On failure this yields an empty fingerprint, which the `-n
  # "$original_fingerprint"` check below already treats as "not a proven
  # replay" — fail closed to requiring a fresh sign-off, never fail open.
  diff_fingerprint() {
    git diff --no-ext-diff --binary -U1 "$@" -- 2>/dev/null | awk '
      /^GIT binary patch$/ { print; inbin=1; next }
      inbin { print; if ($0 == "") inbin=0; next }
      /^diff --git / { print; next }
      /^(old mode|new mode|new file mode|deleted file mode|similarity index|rename from|rename to|copy from|copy to) / { print; next }
      /^Binary files .* differ$/ { print; next }
      /^\+\+\+ / || /^--- / { next }
      /^@@ / { print "@@"; next }
      /^[+ -]/ { print; next }
      { next }
    ' | git hash-object --stdin 2>/dev/null || true
  }

  original_message=$(git log -1 --format=%B "$replay_head")
  current_message=$(<"$commit_msg_file")

  original_fingerprint=$(diff_fingerprint "${replay_head}^!")
  staged_fingerprint=$(diff_fingerprint --cached)

  if [[ "$original_message" == "$current_message" ]] && \
     [[ -n "$original_fingerprint" ]] && [[ "$original_fingerprint" == "$staged_fingerprint" ]] && \
     git interpret-trailers --parse "$commit_msg_file" | grep -qFx "$expected_author_trailer"; then
    # Message AND content (via patch-id) are unchanged from the original commit,
    # AND the original author's trailer is present: this is a faithful, unmodified
    # replay of an already-signed commit, so the original author's signature is
    # still valid. Skip the committer check.
    exit 0
  fi
  # Message was edited, content changed (patch-id mismatch — includes a
  # tree-only amend), author changed, or trailer is missing: the replay is no
  # longer a faithful reproduction of the original, so it needs a fresh sign-off
  # from the current committer. Fall through to the committer check below.
fi

# `git var GIT_COMMITTER_IDENT` resolves the exact identity `git commit -s`
# writes into the trailer (GIT_COMMITTER_NAME/EMAIL env vars, then
# committer.*, then user.* config, in that precedence) — reading only
# user.name/user.email here could diverge from what -s actually wrote and
# reject a correctly signed commit.
#
# Checked explicitly rather than relying on `set -e` to catch a failure here:
# `set -e` would abort the script on a nonzero exit before this point is ever
# reached, so the identity-unresolvable error below would never print.
if ! committer_ident=$(git var GIT_COMMITTER_IDENT); then
  echo "error: could not resolve committer identity to verify DCO sign-off" >&2
  exit 1
fi
committer_name_email=$(sed -E 's/ [0-9]+ [-+][0-9]{4}$//' <<<"$committer_ident")

if [[ -z "$committer_name_email" ]]; then
  echo "error: could not resolve committer identity to verify DCO sign-off" >&2
  exit 1
fi

expected_trailer="Signed-off-by: ${committer_name_email}"

# Parsed via `git interpret-trailers`, not a fixed-string search over the
# whole message: a substring match would also accept that text appearing in
# the commit body, a comment, or an unrelated longer line, none of which are
# an actual trailer.
if ! git interpret-trailers --parse "$commit_msg_file" | grep -qFx "$expected_trailer"; then
  echo "error: commit message is missing the required DCO sign-off trailer:" >&2
  echo "  $expected_trailer" >&2
  echo "" >&2
  echo "Commit with 'git commit -s' (or add the trailer manually) to sign off," >&2
  echo "per this repo's DCO requirement." >&2
  exit 1
fi

exit 0
